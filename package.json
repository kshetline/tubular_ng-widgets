{
  "name": "tubular-ng-widgets",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "prepublishOnly": "npm run build",
    "start": "ng serve",
    "build": "ng build tubular-ng-widgets && sass ./projects/tubular-ng-widgets/src/styles.scss ./dist/tubular-ng-widgets/assets/styles.css",
    "build:demo": "ng build ng-widgets-showcase",
    "watch": "ng build tubular-ng-widgets --watch --configuration development",
    "test": "ng test",
    "lint": "npx eslint 'projects/**/src/**/*.ts'",
    "publish-dry": "npm run build && npm publish --tag latest-nsa ./dist/tubular-ng-widgets/ --dry-run",
    "publish": "npm run build && npm publish --tag latest-nsa ./dist/tubular-ng-widgets/",
    "pack": "npm run build && npm pack ./dist/tubular-ng-widgets/"
  },
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@tubular/math": "^3.3.1",
    "@tubular/time": "^3.9.8",
    "@tubular/util": "^4.16.1",
    "rxjs": "~7.5.5",
    "tslib": "^2.4.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.12",
    "@angular-eslint/eslint-plugin": "^17.5.3",
    "@angular-eslint/eslint-plugin-template": "^17.5.3",
    "@angular-eslint/template-parser": "^17.5.3",
    "@angular/cli": "^17.3.12",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~3.10.6",
    "@types/node": "^12.20.50",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-chai-friendly": "^0.7.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^39.3.6",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-promise": "^6.0.1",
    "jasmine-core": "~4.0.0",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~4.0.2",
    "karma-jasmine-html-reporter": "^1.7.0",
    "ng-packagr": "^17.3.0",
    "typescript": "~5.4.5"
  }
}
